{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "outFile": "extension/content_script.js",
    "removeComments": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true

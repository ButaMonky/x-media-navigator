{
  "manifest_version": 3,
  "name": "X Media Navigator (TypeScript Dev)",
  "description": "Xのメディア一覧を安全に前後移動。投稿内の画像切り替えはXの標準操作を維持します。",
  "version": "2.0.0",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content_script.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

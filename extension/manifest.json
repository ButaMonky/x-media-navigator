{
  "manifest_version": 3,
  "name": "X Media Navigator (TypeScript Dev)",
  "description": "Xメディア閲覧を高速化。左右キーは投稿内画像を優先し、端の画像で別投稿へ移動。前後画像を少数先読み。",
  "version": "2.4.13",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content_script.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

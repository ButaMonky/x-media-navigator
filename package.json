{
  "name": "x-media-navigator",
  "version": "2.4.25-dev.1",
  "private": true,
  "description": "TypeScript rebuild of X media profile navigation; private development",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.background.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.background.json --noEmit",
    "check": "npm run build && node --check extension/content_script.js && node --check extension/background.js",
    "test": "npm run build && tsc -p tsconfig.core.json && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser.test.mjs",
    "test:b4:grid": "npm run build && node tools/b4-grid-performance.mjs",
    "test:mv3": "node tools/mv3-worker-smoke.mjs",
    "test:mv3:archive": "npm run build && node tools/mv3-archive-bridge-smoke.mjs",
    "test:mv3:roundtrip": "npm run build && node tools/mv3-archive-roundtrip-smoke.mjs",
    "test:mv3:history": "npm run build && node tools/mv3-history-jump-smoke.mjs",
    "test:mv3:bfcache": "npm run build && node tools/mv3-history-back-forward-smoke.mjs",
    "test:mv3:b5": "npm run build && node tools/mv3-b5-28-to-29-smoke.mjs",
    "test:mv3:native": "npm run build && node tools/mv3-b5-native-28-to-29-smoke.mjs",
    "test:mv3:fourphoto": "npm run build && node tools/mv3-b5-four-photos-to-next-smoke.mjs",
    "test:mv3:deny": "npm run build && node tools/mv3-b5-deny-consent-smoke.mjs",
    "test:mv3:unverified": "npm run build && node tools/mv3-b5-unverified-cursor-smoke.mjs",
    "test:mv3:reject": "node tools/b1-worker-cdp-probe.mjs",
    "test:navigation-isolated": "node tools/navigation-isolated-probe.mjs",
    "qa:update": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/update-chrome-qa.ps1"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
